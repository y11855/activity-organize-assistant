# 后端环境变量模板
# 使用方式：复制为 .env.local，或在启动前 export 这些变量（Tomcat 部署时写进 bin/setenv.sh）

# ===== MySQL =====
MYSQL_URL=jdbc:mysql://localhost:3306/activity_assistant?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 配置加密（仅当配置里使用 ENC(...) 密文时才需要）=====
# 直接以明文设置 MYSQL_PASSWORD / DRUID_PASSWORD 时可不填此项
JASYPT_ENCRYPTOR_PASSWORD=

# ===== Druid 监控页账号（/api/druid）=====
DRUID_USER=admin
DRUID_PASSWORD=admin

# ===== 上传文件目录 =====
# 集群部署时多个实例必须指向同一目录（绝对路径）
UPLOAD_DIR=/opt/activity/uploads

# ===== 雪花 ID 机器号 =====
# 同一台机器跑多个实例时必须各不相同（1、2、3...），否则会生成重复主键
WORKER_ID=1

# ===== 大模型 API Key（provider 在 application.yml 中切换 qwen/openai/ollama）=====
DASHSCOPE_API_KEY=sk-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx
