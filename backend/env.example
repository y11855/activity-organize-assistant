# 后端环境变量模板
# 使用方式：复制为 .env.local 或在启动前 export 这些变量

# ===== MySQL =====
MYSQL_URL=jdbc:mysql://localhost:3306/activity_assistant?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== MinIO（可选，文件存储用）=====
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=activity-assistant

# ===== 大模型 API Key（按所选 provider 提供对应密钥）=====
OPENAI_API_KEY=sk-xxxxxxxx
DASHSCOPE_API_KEY=sk-xxxxxxxx
