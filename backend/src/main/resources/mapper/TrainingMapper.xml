<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiapp.trainingeval.mapper.TrainingMapper">

    <!-- 占位：复杂查询示例（带状态过滤的分页查询） -->
    <select id="selectTrainingPage" resultType="com.aiapp.trainingeval.vo.TrainingVO">
        SELECT id, title, file_url, status, create_time
        FROM training
        WHERE deleted = 0
        <if test="query.status != null">
            AND status = #{query.status}
        </if>
        <if test="query.studentId != null">
            AND student_id = #{query.studentId}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>
